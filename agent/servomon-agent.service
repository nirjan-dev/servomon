[Unit]
Description=Servomon monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=username
Environment=HOME=/home/username
# Grants rootful Docker socket access (root-equivalent); use the socket's group from `stat -c %G /var/run/docker.sock`.
# SupplementaryGroups=docker
WorkingDirectory=/opt/servomon-agent
ExecStart=/opt/servomon-agent/servomon-agent
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target