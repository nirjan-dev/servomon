# Send metrics by default; only the literal "false" disables sending.
SEND_REQUESTS=true

# controls the frequency of requests, the default option will send 20 requests every 2 minutes
REQUESTS_PER_MINUTE_UNIT=20
MINUTE_UNIT=2

# the URL where the web app can be accessed
SERVER_URL=

# leave AGENT_TOKEN empty on first run: the agent will print a pairing code,
# you approve it from the dashboard (Agents section), and the issued token is
# saved here automatically. never share or commit this token.
AGENT_TOKEN=

# set automatically at enrollment; identifies this agent to the server
AGENT_ID=

# Local debug metrics endpoint, bound to 127.0.0.1 only (default 8282).
PORT=8282

# Display name defaults to the hostname sanitized to letters, digits, . _ -.
# Must be unique across enrolled agents.
NAME=

# Optional Docker Unix socket override. Otherwise uses DOCKER_HOST (unix://),
# active docker context, ~/.docker/desktop/docker.sock, then /var/run/docker.sock.
# The same engine is used for metrics and pause/stop/unpause commands.
# DOCKER_SOCKET=/home/you/.docker/desktop/docker.sock
# DOCKER_HOST=unix:///var/run/docker.sock
