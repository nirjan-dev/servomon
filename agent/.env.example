# whether to send the metrics to the server or not
SEND_REQUESTS=true

# controls the frequency of requests, the default option will send 20 requests every 2 minutes
REQUESTS_PER_MINUTE_UNIT=20
MINUTE_UNIT=2

# the URL where the web app can be accessed
SERVER_URL=

# leave AGENT_TOKEN empty on first run: the agent will print a pairing code,
# you approve it from the dashboard (Agents section), and the issued token is
# saved here automatically. never share or commit this token.
AGENT_TOKEN=

# set automatically at enrollment; identifies this agent to the server
AGENT_ID=

# the port you want the CLI to use, you can set it to any available port you want to use
PORT=8282

# the name you want to show up on the web app for the server this CLI is installed on
# must be unique across enrolled agents (letters, numbers, dots, dashes, underscores)
NAME=
