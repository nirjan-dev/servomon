{
  "name": "@servomon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate:schema": "ts-to-zod ../shared/types.ts ./shared/schemas.zod.ts && cp ./shared/schemas.zod.ts ../agent/schemas/",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
    "test:s1": "node --test test/s1-auth.test.mjs",
    "test:retention": "node --experimental-strip-types --test test/retention.test.mjs",
    "test": "node --experimental-strip-types --test test/retention.test.mjs test/battery.test.mjs && node --test test/s1-auth.test.mjs"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.5.9",
    "@iconify-json/lucide": "^1.2.147",
    "@kgierke/nuxt-basic-auth": "1.7.0",
    "@nuxt/ui": "^4.12.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vite-pwa/nuxt": "1.1.1",
    "nuxt": "^4.6.3",
    "tailwindcss": "^4.3.3",
    "ts-to-zod": "^3.15.0",
    "vue": "^3.5.44",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@9.11.0+sha512.0a203ffaed5a3f63242cd064c8fb5892366c103e328079318f78062f24ea8c9d50bc6a47aa3567cabefd824d170e78fa2745ed1f16b132e16436146b7688f19b",
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/web-push": "^3.6.4",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "crossws": "0.4.16"
    }
  }
}
