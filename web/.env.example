# only needed if you want discord alerts
# docs: https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks
NUXT_DISCORD_WEBHOOK_URL=
NUXT_PUBLIC_ENABLE_DISCORD_ALERTS=false

# operator login for the dashboard and API: username1:password1,username2:password2,etc
# required — without at least one user, every operator route denies all requests
NUXT_BASIC_AUTH_USERS=username:password
NUXT_BASIC_AUTH_ENABLED=true

# single-use WebSocket handshake ticket lifetime in seconds (default 60).
# only override for tests; production should keep the default.
# NUXT_WS_TICKET_TTL_SECONDS=60

# NOTE: agent credentials are NOT configured here. Agents enroll from the
# dashboard (Agents section): run the agent without AGENT_TOKEN, approve its
# pairing code, and the server issues its token. See README "Adding an agent".

# you can generate the keys with `pnpm generate:vapid-keys` or `npx web-push generate-vapid-keys`
# only needed if you want to use web push notifications
NUXT_PUBLIC_PUSH_PUBLIC_KEY=
NUXT_PUSH_PRIVATE_KEY=
