# Required: dashboard/API operator credentials, user:password[,user2:password2]. No default.
NUXT_BASIC_AUTH_USERS=admin:change-this-password
# Required security setting: leave enabled (default true).
NUXT_BASIC_AUTH_ENABLED=true

# Optional: public VAPID key; default empty. Set BOTH keys or leave BOTH empty
# to generate and persist a key pair automatically in the data volume.
NUXT_PUBLIC_PUSH_PUBLIC_KEY=
# Optional: private VAPID key; default empty. Keep secret; pair with public key.
NUXT_PUSH_PRIVATE_KEY=
# Optional: VAPID contact URI (mailto: or https:). Default shown below.
NUXT_PUSH_SUBJECT=https://servomon.nirjan.dev

# Optional: Discord webhook URL for alert delivery; default empty (disabled).
NUXT_DISCORD_WEBHOOK_URL=
# Optional: show/enable Discord alerts; default false.
NUXT_PUBLIC_ENABLE_DISCORD_ALERTS=false
# Optional: single-use WebSocket ticket lifetime in seconds; default 60.
NUXT_WS_TICKET_TTL_SECONDS=60
# Optional: HTTP listener port; default 3000. Keep 3000 for these deploy files.
PORT=3000
# Optional: data root override; default ./data (/app/data in the image).
# SERVOMON_DATA_DIR=/app/data

# Required only for compose.https.yaml: DNS hostname pointing to your server.
# Default: none. localhost uses Caddy's local CA; public DNS gets public TLS.
# SERVOMON_DOMAIN=monitor.example.com
